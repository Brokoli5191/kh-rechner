<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only used for the Open Food Facts lookup after a barcode scan. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Only for the scanner built into the app, which takes over where Google's scanner cannot
        run. It is asked for the first time that scanner opens; frames are read on the device.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
        The update section installs new releases from GitHub. Android asks the user once to allow
        "install unknown apps" for this app; after that it may update itself without a dialog.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <queries>
        <!-- Needed to see whether AAPS is installed and to open it (see AndroidAapsHandoff). -->
        <package android:name="info.nightscout.androidaps" />

        <!--
            Google's code scanner looks its camera screen up inside Google Play services before
            every scan and reports "module not ready" if it cannot see it. Play services is visible
            to all apps on stock devices; these entries make sure of it everywhere else.
        -->
        <package android:name="com.google.android.gms" />
        <intent>
            <action android:name="com.google.android.gms.mlkit.ACTION_SCAN_BARCODE" />
        </intent>
    </queries>

    <application
        android:name=".KhRechnerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KhRechner.Splash">

        <!--
            Lets Play Store installs fetch Google's scanner module at install time. The APK from
            GitHub Releases never goes through that path, so KhRechnerApplication requests the
            module explicitly via ModuleInstallClient as well.
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- Android's answer to an update handed to its installer; only Android sends it. -->
        <receiver
            android:name=".data.UpdateInstallReceiver"
            android:exported="false" />

        <!-- uiMode is handled by Compose itself, so switching the theme does not restart the activity. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
