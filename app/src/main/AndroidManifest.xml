<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only used for the Open Food Facts lookup after a barcode scan. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <!-- Needed to see whether AAPS is installed and to open it (see AndroidAapsHandoff). -->
        <package android:name="info.nightscout.androidaps" />

        <!--
            The code scanner library looks its camera screen up inside Google Play services before
            every scan and reports "module not ready" if it cannot see it. Play services is visible
            to all apps on stock devices; these entries make sure of it everywhere else.
        -->
        <package android:name="com.google.android.gms" />
        <intent>
            <action android:name="com.google.android.gms.mlkit.ACTION_SCAN_BARCODE" />
        </intent>
    </queries>

    <application
        android:name=".KhRechnerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KhRechner.Splash">

        <!--
            Lets Play Store installs fetch the scanner module at install time. The APK from GitHub
            Releases never goes through that path, so KhRechnerApplication requests the module
            explicitly via ModuleInstallClient as well.
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- uiMode is handled by Compose itself, so switching the theme does not restart the activity. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
