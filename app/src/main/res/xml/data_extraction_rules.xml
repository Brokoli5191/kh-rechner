<?xml version="1.0" encoding="utf-8"?>
<!-- Saved calculations, settings and the product cache are small and worth keeping across devices. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
